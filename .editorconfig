# Editor-agnostic formatting defaults, matching the Go toolchain.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.go]
# gofmt uses tabs; editors must not expand them (gofmt -l is a CI gate).
indent_style = tab
indent_size = 4

[{*.yaml,*.yml,*.json,*.md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
