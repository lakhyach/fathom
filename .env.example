# Fathom — example environment values for local development.
# EVERY value here is a fake local default; .env is never committed.
# The application reads process environment variables; it does not load this file.

# --- loaded now --------------------------------------------------------------
FATHOM_ENV=dev                       # dev | prod
FATHOM_MODE=all                      # control | worker | relay | all (CLI arg overrides)
FATHOM_LOG_LEVEL=info                # debug | info | warn | error
FATHOM_HTTP_ADDR=127.0.0.1:8080      # loopback by default (security baseline)
FATHOM_SHUTDOWN_TIMEOUT=10s          # graceful shutdown budget
FATHOM_DATABASE_URL=postgres://fathom:changeme-local-only@127.0.0.1:5432/fathom?sslmode=disable
# Required when the mode serves the HTTP API (control/all). label:role:key, comma-separated;
# role is reader|operator|admin. These values are CHANGE_ME fakes — never commit real keys.
FATHOM_API_KEYS=op:operator:changeme-local-only-key-0,rd:reader:changeme-local-only-key-1,ad:admin:changeme-local-only-admin-key-2
FATHOM_READY_MAX_OUTBOX_AGE=5m       # /readyz relay-lag threshold
# FATHOM_RELAY_ID=relay-1            # durable relay identity (default: generated UUIDv7)
# FATHOM_WORKER_ID=worker-1          # durable worker identity (default: generated UUIDv7)
# FATHOM_DEV_ECHO=1                  # registers the deterministic echo SAMPLE participant (dev wiring only — never a domain participant)

# --- optional / deferred ------------------------------------------------------
# FATHOM_RELAY=pgoutbox              # pgoutbox | cdc-debezium
# FATHOM_KAFKA_BROKERS=127.0.0.1:9092  # bare host:port ONLY (comma-separated list); optional for the default local pgoutbox path
# FATHOM_OTLP_ENDPOINT=http://127.0.0.1:4318
