# Fathom — example configuration. Copy to .env (git-ignored) and adjust.
# EVERY value here is a fake local default; .env is never committed.
# The foundation (internal/config) reads ONLY the "loaded now" keys below.
# Keys under "reserved" are documented for later phases and are NOT read yet.

# --- loaded now --------------------------------------------------------------
FATHOM_ENV=dev                       # dev | prod
FATHOM_LOG_LEVEL=info                # debug | info | warn | error
FATHOM_HTTP_ADDR=127.0.0.1:8080      # loopback by default (security baseline)
FATHOM_SHUTDOWN_TIMEOUT=10s          # graceful shutdown budget
FATHOM_DATABASE_URL=postgres://fathom:changeme-local-only@127.0.0.1:5432/fathom?sslmode=disable

# --- reserved for later phases (not read by the foundation yet) --------------
# FATHOM_RELAY=pgoutbox              # pgoutbox | cdc-debezium
# FATHOM_KAFKA_BROKERS=127.0.0.1:9092  # bare host:port ONLY — PLAINTEXT:// prefixes are a broker concept and a client parse error (Phase 1 DS-10)
# FATHOM_OTLP_ENDPOINT=http://127.0.0.1:4318
