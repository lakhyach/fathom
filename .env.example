# Fathom — example configuration. EVERY value here is a fake demo default.
# Real values are injected per-process via environment; nothing else is read.
# CI gate RT-08 fails the build if a non-example file contains `password:` with a non-fake value.

# --- control plane -----------------------------------------------------------
FATHOM_HTTP_ADDR=:8080
FATHOM_DB_URL=postgres://fathom_app:changeme-local-only@localhost:5432/fathom?sslmode=disable

# --- relay -------------------------------------------------------------------
FATHOM_RELAY=pgoutbox                # pgoutbox | cdc-debezium
FATHOM_KAFKA_BROKERS=localhost:9092  # bare host:port ONLY — listener-scheme prefixes (PLAINTEXT://) are a broker-side concept and a client-config parse error (Phase 1 DS-10)

# --- auth (demo identities, obviously fake) ----------------------------------
FATHOM_API_KEY_READER=fp_demo_reader_only_not_a_secret
FATHOM_API_KEY_OPERATOR=fp_demo_operator_only_not_a_secret
FATHOM_API_KEY_ADMIN=fp_demo_admin_only_not_a_secret
FATHOM_SESSION_SECRET=changeme-local-only

# --- workers (showcase participants) -----------------------------------------
FATHOM_WORKER_ID=worker-local-1
FATHOM_BOOKING_DB_URL=postgres://fathom_app:changeme-local-only@localhost:5433/booking?sslmode=disable
FATHOM_PAYMENT_DB_URL=postgres://fathom_app:changeme-local-only@localhost:5434/payment?sslmode=disable

# --- telemetry ----------------------------------------------------------------
FATHOM_OTLP_ENDPOINT=http://localhost:4318
FATHOM_LOG_LEVEL=info
